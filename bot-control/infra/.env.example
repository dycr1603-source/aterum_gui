# Runtime
TZ=Etc/UTC
NGINX_PORT=80
NGINX_HTTPS_PORT=443
DASHBOARD_PORT=3001
CHART_API_PORT=3000
N8N_PORT=5678

# Public domain. Compose derives every public URL from this value.
APP_DOMAIN=aterum.duckdns.org

# Database and Redis (use random values of at least 32 characters)
MYSQL_ROOT_PASSWORD=
DB_HOST=mysql
DB_USER=tradingbot
DB_PASSWORD=
DB_NAME=trading_bot
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+00:00
REDIS_PASSWORD=

# Dashboard authentication
SESSION_SECRET=
JWT_SECRET=
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=

# Internal compatibility URLs
INTERNAL_DASHBOARD_BASE=http://127.0.0.1:3001
INTERNAL_N8N_BASE=http://127.0.0.1:5678

# n8n
N8N_VERSION=2.26.8
N8N_PROTOCOL=https
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_BASIC_AUTH_ACTIVE=false
NODES_EXCLUDE=[]
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_RUNNERS_INSECURE_MODE=true
N8N_TRADING_WORKFLOW_ID=Cz4TfvaVAygWGRJm
N8N_TRADING_DISABLED=1

# External integrations
BINANCE_API_KEY=
BINANCE_API_SECRET=
POSITION_GUARD_BINANCE_API_KEY=
POSITION_GUARD_BINANCE_API_SECRET=
POSITION_GUARD_ENFORCE=false
POSITION_GUARD_POLL_MS=5000
POSITION_GUARD_UNPROTECTED_GRACE_MS=60000
KNOWLEDGE_CACHE_TTL_MS=30000
POSITION_GUARD_HEALTH_MS=60000
POSITION_GUARD_ALERT_COOLDOWN_MS=300000
EXECUTION_ENGINE_TOKEN=change_me_execution_engine_token
ANTHROPIC_API_KEY=
RESEARCH_ANTHROPIC_API_KEY=
TELEGRAM_ANTHROPIC_API_KEY=
TELEGRAM_CLAUDE_MODEL=claude-haiku-4-5-20251001
TELEGRAM_AI_CACHE_TTL_SECONDS=300
TELEGRAM_AI_MAX_INPUT_CHARS=3000
TELEGRAM_AI_MAX_TOKENS=400
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5-mini
SIMULATOR_POLICY_KEY=aterum_policy_v1
