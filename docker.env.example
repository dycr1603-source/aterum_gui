# Copy to .env. Never commit the populated file.
NODE_ENV=production
TZ=Etc/UTC
APP_DOMAIN=localhost
DASHBOARD_PORT=3001
CHART_API_PORT=3000
N8N_PORT=5678
NGINX_PORT=8080

DB_NAME=trading_bot
DB_USER=tradingbot
DB_PASSWORD=replace_with_a_long_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_root_password
REDIS_PASSWORD=replace_with_a_long_random_redis_password
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+00:00

SESSION_SECRET=replace_with_a_long_random_session_secret
JWT_SECRET=replace_with_a_long_random_jwt_secret
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=replace_before_first_login
EXECUTION_ENGINE_TOKEN=replace_with_a_long_random_execution_token

# Keep external integrations empty while validating the local stack.
BINANCE_API_KEY=
BINANCE_API_SECRET=
POSITION_GUARD_BINANCE_API_KEY=
POSITION_GUARD_BINANCE_API_SECRET=
POSITION_GUARD_ENFORCE=false
N8N_TRADING_DISABLED=1

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RESEARCH_ANTHROPIC_API_KEY=
TELEGRAM_ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

N8N_VERSION=2.26.8
N8N_ENCRYPTION_KEY=replace_with_a_long_random_n8n_encryption_key
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
N8N_TRADING_WORKFLOW_ID=Cz4TfvaVAygWGRJm
SIMULATOR_POLICY_KEY=aterum_policy_v1
TRADES_FILE=/data/trades.json
