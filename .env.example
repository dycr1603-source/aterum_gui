NODE_ENV=production

# Bind/ports (no IP fija)
BIND_HOST=0.0.0.0
DASHBOARD_PORT=3001
CHART_API_PORT=3000

# Public domain. Compose derives every public URL from this value.
APP_DOMAIN=aterum.duckdns.org

# DNS interno recomendado
INTERNAL_DASHBOARD_BASE=http://dashboard.internal:3001
INTERNAL_N8N_BASE=http://n8n.internal:5678

# Database
DB_HOST=localhost
DB_USER=tradingbot
DB_PASSWORD=change_me
DB_NAME=trading_bot
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+00:00

# Auth
SESSION_SECRET=change_me_to_a_long_random_secret
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=change_me_after_first_login

# Binance account read/trade endpoints used by the dashboard
BINANCE_API_KEY=change_me
BINANCE_API_SECRET=change_me
POSITION_GUARD_BINANCE_API_KEY=change_me_guard_key
POSITION_GUARD_BINANCE_API_SECRET=change_me_guard_secret
POSITION_GUARD_ENFORCE=false
POSITION_GUARD_POLL_MS=5000
POSITION_GUARD_UNPROTECTED_GRACE_MS=60000
KNOWLEDGE_CACHE_TTL_MS=30000
POSITION_GUARD_HEALTH_MS=60000
POSITION_GUARD_ALERT_COOLDOWN_MS=300000
EXECUTION_ENGINE_TOKEN=change_me_execution_engine_token

# OpenAI assistant
OPENAI_API_KEY=change_me
OPENAI_ASSISTANT_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=change_me
TELEGRAM_ANTHROPIC_API_KEY=change_me_telegram_only
TELEGRAM_CLAUDE_MODEL=claude-haiku-4-5-20251001
TELEGRAM_AI_CACHE_TTL_SECONDS=300
TELEGRAM_AI_MAX_INPUT_CHARS=3000
TELEGRAM_AI_MAX_TOKENS=400

# Telegram Control (read-only)
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_CHAT_ID=change_me
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# n8n simulator source
N8N_SQLITE_DB=/home/n8n/.n8n/database.sqlite
N8N_TRADING_WORKFLOW_ID=Cz4TfvaVAygWGRJm
SIMULATOR_POLICY_KEY=aterum_policy_v1
N8N_TRADING_DISABLED=0

# Local runtime data
TRADES_FILE=./trades.json
